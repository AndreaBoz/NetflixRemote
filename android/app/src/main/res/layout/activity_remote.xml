<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disconnected"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etHost"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:hint="@string/host_hint"
                android:inputType="text"
                android:autofillHints="" />

            <EditText
                android:id="@+id/etPin"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/pin_hint"
                android:inputType="number"
                android:maxLength="6"
                android:autofillHints="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/connect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/scan" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:alpha="0.4"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:textSize="22sp"
                android:text="@string/b_playpause" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack30"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="76dp" android:text="@string/b_back30" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack10"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="76dp" android:layout_marginStart="8dp"
                    android:text="@string/b_back10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFwd10"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="76dp" android:layout_marginStart="8dp"
                    android:text="@string/b_fwd10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFwd30"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="76dp" android:layout_marginStart="8dp"
                    android:text="@string/b_fwd30" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkip"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="10dp"
                android:text="@string/b_skip" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="76dp" android:text="@string/b_voldown" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMute"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="76dp" android:layout_marginStart="8dp"
                    android:text="@string/b_mute" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="76dp" android:layout_marginStart="8dp"
                    android:text="@string/b_volup" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNav"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/b_nav" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunch"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/b_launch" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRole"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/change_role" />
    </LinearLayout>
</ScrollView>
